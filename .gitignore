# Exclude SpecStory files and directories
.specstory/
# Exclude environment config
.env
.env.*
!.env.example
# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Local-only / not part of public demo
examples/
scripts/security/

# If you do not intend to make scripts a package:
scripts/__init__.py

# ── Local/private roster (never commit) ─────────────────────────────────────
data_private/

# ── Data (public-safe) ─────────────────────────────────────────────────────
# Ignore everything under data/ by default, then allow only curated demo inputs.
data/**
!data/**/
!data/**/.gitkeep

!data/artists/aria_velvet.json
!data/artists/king_juno.json
!data/artists/nova_saint.json
!data/bridge/aria_velvet_*.json
!data/bridge/king_juno_*.json
!data/bridge/nova_saint_*.json

# Optional: allow demo metrics
!data/metrics/**
!data/metrics/**/

# Always ignore drafts / personal outputs even if under allowed dirs
data/checkin/

# Explicitly ignore sensitive context/config even if someone tries to add it
data/lr_records_context.json
data/brett_communication_profile.json
data/bridge_learnings.json
data/autopilot_config.json
data/autopilot_actions.log

# Ignore common generated output folders
data/atlas/
data/echo/
data/forge/
data/sage/
data/vinyl/
data/ai_conversations/
data/briefings/
data/manifests/
data/workflows/
data/metrics/labelgrid/
studio/data/
live/data/

# ── Internal documents ───────────────────────
*.pdf
*.html
!templates/*.html

# Allow GitHub Pages /docs site
!docs/
!docs/**/*.html

# ── .env.example is safe to commit ───────────
!.env.example

# ── OS ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Large files ──────────────────────────────
*.gguf
models/

# ── Logs ─────────────────────────────────────
*.log
logs/.env
.env

# ── LLM call audit trail (core/llm_audit.py) ─────────────────
# Contains raw prompts/responses; already covered by the blanket
# data/** rule above, listed explicitly here for clarity.
data/llm_audit/

Claude outputs/
*.patch