# .env.example for Rascalworks OS

# Webhook endpoint (receives artist check-ins & state change pings)
WEBHOOK_URL=http://localhost:5678/webhook/health-update

# Flask app port (default: 8080)
PORT=8080

SECRET_KEY=replace-with-random-secret  # Flask secret key for sessions (MANDATORY)

# LLM config (choose any supported provider)
LLM_PROVIDER=ollama
# Optional generic model fallback used by some providers
# LLM_MODEL=gpt-4o-mini

# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama2
# OLLAMA_NUM_CTX=4096
# OLLAMA_TIMEOUT_SECONDS=1800

# ANTHROPIC_API_KEY=sk-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# DEEPSEEK_API_KEY=...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Generic OpenAI-compatible provider (OpenRouter, self-hosted gateways, etc.)
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=...
# LLM_MODEL=gpt-4o-mini

# LiteLLM multi-provider router
# LLM_PROVIDER=litellm
# LITELLM_MODEL=openai/gpt-4o-mini
# LITELLM_API_BASE=https://your-endpoint/v1
# LITELLM_API_KEY=...

MAESTRO_TOKEN=your-secret-here         # Token for dashboard/API auth (MANDATORY)
MAESTRO_DEV_MODE=0                     # Set to 1 to bypass token login (dev only)

WEBHOOK_SECRET=replace-with-shared-secret  # Shared secret for inbound webhooks (MANDATORY)

PREMIUM_FEATURES_ENABLED=true           # Set to 'false' to run open core only

# Optional integration base URLs
# MAESTRO_BASE_URL=http://localhost:8080
# N8N_BASE_URL=http://localhost:5678
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/health-update

# Optional local data path override for scripts
# MAESTRO_DATA_DIR=./data

# Optional service/API integrations
# GOOGLE_MAPS_API_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# INSTAGRAM_ACCESS_TOKEN=...
# INSTAGRAM_PAGE_ID_DEFAULT=...
# X_BEARER_TOKEN=...
# SPOTIFY_ACCESS_TOKEN=...
# ORCHARD_API_KEY=...

# Optional email notification settings (check-in/webhook scripts)
# SENDER_EMAIL=sender@example.com
# EMAIL_ADDRESS=recipient-or-login@example.com
# EMAIL_PASSWORD=app-password-or-secret
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=465

# Set log level (optional: DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Example: Enable other features
# FEATURE_X=true

# Add other key-value pairs as needed for prod or advanced agents

# SCRIBE / Label Department Blog Master
EASYFUNNELS_API_KEY=
EASYFUNNELS_BLOG_ENDPOINT=
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=
SCRIBE_N8N_WEBHOOK_URL=
SCRIBE_SOCIAL_X_BEARER_TOKEN=
SCRIBE_SOCIAL_FACEBOOK_PAGE_TOKEN=
SCRIBE_SOCIAL_FACEBOOK_PAGE_ID=
SCRIBE_SOCIAL_INSTAGRAM_ACCESS_TOKEN=
SCRIBE_SOCIAL_INSTAGRAM_BUSINESS_ID=
SCRIBE_SOCIAL_TELEGRAM_BOT_TOKEN=
SCRIBE_SOCIAL_TELEGRAM_CHANNEL_ID=
SCRIBE_SOCIAL_MASTODON_ACCESS_TOKEN=
SCRIBE_SOCIAL_MASTODON_INSTANCE_URL=